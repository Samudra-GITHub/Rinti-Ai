# Copy to backend/.env and fill in. Never commit the real .env file.

# ── Cloud provider (optional when running local-only) ──────────────────────────
# Any OpenAI-compatible API; Groq by default.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Cloud model name. Defaults to the legacy MODEL_NAME setting, then openai/gpt-oss-120b.
# RINTI_CLOUD_MODEL=openai/gpt-oss-120b

# ── Where replies are generated ────────────────────────────────────────────────
# groq   = cloud only (the original behaviour; also the safe default for hosting)
# ollama = local models through Ollama on this machine
RINTI_DEFAULT_PROVIDER=ollama
# With ollama: allow the cloud as a fallback when the local model fails?
#   false = strict local-only: conversations never leave this machine
#   true  = "auto": local first, cloud if the local model fails before replying
RINTI_CLOUD_FALLBACK=false
# In auto mode, also send unusually demanding prompts (proofs, long analyses)
# to the cloud model. Off by default.
RINTI_CLOUD_ESCALATION=false

# Only suggest models whose licence permits commercial use (Apache-2.0, MIT).
# Set to true for any commercial deployment; models are checked, never assumed.
RINTI_COMMERCIAL_USE=false
# Refuse (with an explanation and options, never a silent cloud switch) a local
# model that clearly can't fit this computer's memory.
RINTI_HARDWARE_CHECK=true

# ── Local models (Ollama) ──────────────────────────────────────────────────────
RINTI_OLLAMA_BASE_URL=http://127.0.0.1:11434
RINTI_DEFAULT_MODEL=qwen2.5:7b
# Optional: a separate model for programming questions (defaults to the above).
# RINTI_CODING_MODEL=qwen2.5-coder:7b
# Optional: a smaller, faster model for classification (defaults to the above).
# RINTI_FAST_MODEL=
# Largest context window requested from Ollama (bigger = more memory). It is
# lowered automatically when this computer can't hold it for the chosen model.
RINTI_LOCAL_NUM_CTX=8192
RINTI_LOCAL_MAX_RESPONSE_TOKENS=2048
RINTI_OLLAMA_KEEP_ALIVE=10m

# ── Safety limits ──────────────────────────────────────────────────────────────
# Local generations running at once (a laptop GPU handles one well).
RINTI_LOCAL_MAX_CONCURRENCY=1
RINTI_QUEUE_TIMEOUT=60
RINTI_REQUEST_TIMEOUT=300

# Changing inference settings from the UI works from this machine without a
# token. On a public deployment, set a long random value to allow it remotely;
# leave empty to refuse remote changes.
# RINTI_ADMIN_TOKEN=

# ── Other settings ─────────────────────────────────────────────────────────────
# TAVILY_API_KEY=            # web research
# DATABASE_URL=              # Postgres (required when ENVIRONMENT=production)
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# MAX_CHAT_MESSAGES_PER_DAY=40      # applies to cloud replies only
# MAX_RESPONSE_TOKENS=4096          # cloud reply ceiling
